<?xml version="1.0" encoding="utf-8"?>
<!-- Chillers launch screen: pitch-black stage, mark centred, no text. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_black" />
    <item>
        <bitmap
            android:src="@mipmap/launch_mark"
            android:gravity="center"
            android:dither="true" />
    </item>
</layer-list>
