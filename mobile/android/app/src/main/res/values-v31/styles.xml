<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws its own system splash from these attributes; without
         them the launch window falls back to the light colorBackground. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/launch_black</item>
        <item name="android:navigationBarColor">@color/launch_black</item>
        <item name="android:windowSplashScreenBackground">@color/launch_black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/launch_mark</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launch_black</item>
    </style>
</resources>
