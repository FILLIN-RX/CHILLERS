{
  "name": "matches-backend",
  "version": "1.0.0",
  "description": "Standalone Matches and Sports API for Chillers",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "sync:oha": "tsx src/modules/live/sync-oha-catalog.ts",
    "sync:oha:revalidate": "tsx src/modules/live/sync-oha-catalog.ts --revalidate",
    "sync:oha:epg": "tsx src/modules/live/sync-oha-catalog.ts --epg",
    "sync:epg": "tsx src/modules/live/sync-fr-epg.ts",
    "test": "tsx --test src/modules/live/utils/__tests__/epg.test.ts"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cloudscraper": "^4.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lru-cache": "^11.0.2",
    "mongoose": "^8.24.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
